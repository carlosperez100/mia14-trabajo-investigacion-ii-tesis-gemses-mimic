# Copiar a .env y completar. Ningún script tiene rutas absolutas escritas: todas salen de aquí.
MIMIC_DIR=C:/MIMIC/mimiciv              # carpeta de MIMIC-IV (DUA PhysioNet) con hosp/ (admissions, patients, diagnoses_icd, d_icd_diagnoses, drgcodes, services) e icu/ (icustays)
MIMIC_NOTE_DIR=C:/MIMIC/note            # carpeta con discharge.csv.gz (MIMIC-IV-Note v2.2)
ETIQUETAS_DIR=C:/tesis/datos_intermedios  # salidas de las fases 3 v2, 8 y 7 de la tesis (etiquetas A1)
ERSP_XLSX=                              # corpus ERSP EsSalud (datos personales): fuera del repo, no se usa en Sprint 1
MIMIC_DIR_ALT=                          # opcional: segunda carpeta de MIMIC-IV si las tablas hosp/ e icu/ están repartidas
# Prototipo (prototipo/README.md). Todo queda fuera del repositorio.
PROTOTIPO_DATOS=                        # carpeta local de la base, la bitácora y los modelos; por defecto ~/.mia14_prototipo
PROTOTIPO_MODELO=                       # modelo entrenado con MIMIC-IV por prototipo.entrenar_local (nunca se publica)
PROTOTIPO_MODELO_SHA256=                # huella SHA-256 que imprime prototipo.entrenar_local
PROTOTIPO_IMPACTOS_CSV=                 # CSV local con los impactos C, D, E y F del Anexo N.° 02 (no se versiona)
